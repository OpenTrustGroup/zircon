LOCAL_DIR := $(GET_LOCAL_DIR)

MODULE := $(LOCAL_DIR)

MODULE_TYPE := userapp
MODULE_GROUP := test

MODULE_SRCS := \
    $(wildcard $(LOCAL_DIR)/*/*.c) \
    $(wildcard $(LOCAL_DIR)/*/*.cpp) \
    $(wildcard $(LOCAL_DIR)/*/*.S) \
    $(LOCAL_DIR)/main.c \

MODULE_SRCS := \
    $(filter-out $(LOCAL_DIR)/pager/main.cpp $(LOCAL_DIR)/stream/%,$(MODULE_SRCS))

ifneq (true,$(call TOBOOL,$(WITH_USER_PAGER)))
# The zx_pager_* syscalls answer ZX_ERR_NOT_SUPPORTED when the kernel is built
# without the user pager, so the pager cases have nothing to exercise.
MODULE_SRCS := \
    $(filter-out $(LOCAL_DIR)/pager/%,$(MODULE_SRCS))
endif

MODULE_NAME := core-tests

MODULE_STATIC_LIBS := \
    system/ulib/ddk \
    system/ulib/fbl \
    system/ulib/runtime \
    system/ulib/sync \

# This separate library is a hack to deal with these functions needing to be compiled with
# -fno-stack-protector
MODULE_STATIC_LIBS += system/utest/core/threads/thread-functions

# Extra static libs required by the pager tests, which are compiled into
# core-tests so they run under userboot with the root resource.
MODULE_STATIC_LIBS += \
    system/ulib/zx \
    system/ulib/inspector \
    system/ulib/zxcpp

MODULE_LIBS := \
    system/ulib/unittest \
    system/ulib/mini-process \
    system/ulib/zircon \
    system/ulib/c

# Extra shared libs required by the pager tests (backtrace/unwind support).
MODULE_LIBS += \
    system/ulib/fdio \
    third_party/ulib/backtrace \
    third_party/ulib/ngunwind

# Disable warnings that are common in imported pager test code.
MODULE_COMPILEFLAGS += -Wno-unused-parameter

MODULE_DEFINES := BUILD_COMBINED_TESTS=1

# core/channel needs a header file generated by kernel/lib/vdso/rules.mk.
MODULE_COMPILEFLAGS += -I$(BUILDDIR)/kernel/lib/vdso
MODULE_SRCDEPS += $(BUILDDIR)/kernel/lib/vdso/vdso-code.h

include make/module.mk

MODULES += $(patsubst %/rules.mk,%,$(wildcard $(LOCAL_DIR)/*/rules.mk))
